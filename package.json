{
  "name": "autolyric-scoreflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "scripts",
    "public/omr-loader.js",
    "public/omr-worker-core.js",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "OPEN_SOURCE_NOTICE.md"
  ],
  "scripts": {
    "dev": "vite",
    "source:pack": "node scripts/pack-source.mjs",
    "omr:vendor": "node scripts/vendor-omr.mjs",
    "build": "npm run source:pack && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "jszip": "^3.10.2",
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.8.11",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
